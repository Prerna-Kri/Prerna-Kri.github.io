---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/common/TableOfContents.astro';
import { formatDate } from '../lib/dates';
import { withBase } from '../lib/paths';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  date: Date | string;
  updated?: Date | string;
  tags?: string[];
  readingTime?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { title: string; slug: string };
  nextPost?: { title: string; slug: string };
}

const {
  title,
  description,
  date,
  updated,
  tags = [],
  readingTime = '4 min read',
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = formatDate(date);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: new Date(date).toISOString(),
  dateModified: updated ? new Date(updated).toISOString() : new Date(date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Prerna Kumari',
  },
};

const tocHeadings = headings
  .filter((h) => h.depth <= 3)
  .map((h) => ({ id: h.slug, label: h.text }));
---

<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <!-- Sticky 2px reading progress bar in the ramp pinned to top of viewport per §7.6 -->
  <div class="fixed top-0 left-0 right-0 z-50 h-[2px] bg-transparent pointer-events-none" aria-hidden="true">
    <div
      id="reading-progress-bar"
      class="h-full w-0 transition-all duration-75"
      style="background: linear-gradient(90deg, var(--accent-plasma-1), var(--accent-plasma-2), var(--accent-plasma-3), var(--accent-plasma-4));"
    ></div>
  </div>

  <div class="frame pt-28 pb-20">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-12">
      <!-- Main article container (70ch measure per §7.6) -->
      <article class="xl:col-span-8 space-y-8 max-w-[70ch]">
        <header class="space-y-4 border-b border-[var(--border-hairline)] pb-8">
          <div class="flex flex-wrap items-center gap-3 text-[var(--step--1)] font-mono text-[var(--text-muted)]">
            <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
            <span>·</span>
            <span>{readingTime}</span>
          </div>

          <h1
            class="text-[var(--step-3)] sm:text-[var(--step-4)] font-bold text-[var(--text-heading)] leading-tight tracking-tight"
            style="font-family: var(--font-display); font-weight: 700;"
          >
            {title}
          </h1>

          <p class="text-[var(--step-0)] text-[var(--text-body)]">
            {description}
          </p>

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {tags.map((tag) => (
                <span class="font-mono text-xs px-2 py-0.5 rounded-[4px] bg-[var(--bg-well)] border border-[var(--border-hairline)] text-[var(--text-muted)]">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Post Body (MDX with KaTeX & Shiki) -->
        <div class="prose">
          <slot />
        </div>

        <!-- Prev / Next Navigation per §7.6 -->
        <nav aria-label="Post navigation" class="mt-16 pt-8 border-t border-[var(--border-hairline)] grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs">
          {prevPost ? (
            <a
              href={withBase(`/writing/${prevPost.slug}`)}
              class="p-4 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] hover:border-[var(--interactive)] text-[var(--text-muted)] hover:text-[var(--text-heading)] transition-colors flex flex-col gap-1"
            >
              <span class="font-mono text-[10px] uppercase text-[var(--interactive)]">&larr; Previous</span>
              <span class="font-medium text-sm text-[var(--text-heading)]">{prevPost.title}</span>
            </a>
          ) : <div />}

          {nextPost ? (
            <a
              href={withBase(`/writing/${nextPost.slug}`)}
              class="p-4 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] hover:border-[var(--interactive)] text-[var(--text-muted)] hover:text-[var(--text-heading)] transition-colors flex flex-col gap-1 text-right"
            >
              <span class="font-mono text-[10px] uppercase text-[var(--interactive)]">Next &rarr;</span>
              <span class="font-medium text-sm text-[var(--text-heading)]">{nextPost.title}</span>
            </a>
          ) : <div />}
        </nav>
      </article>

      <!-- Margin Table of Contents at xl+ per §7.6 -->
      {tocHeadings.length > 0 && (
        <aside class="hidden xl:block xl:col-span-4">
          <div class="sticky top-28 space-y-4 max-w-[280px]">
            <div class="font-mono text-xs uppercase text-[var(--text-muted)] tracking-wider">
              Outline
            </div>
            <TableOfContents headings={tocHeadings} />
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  function updateReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollTotal > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollTotal)) : 0;
    bar.style.width = `${progress * 100}%`;
  }

  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  document.addEventListener('astro:page-load', updateReadingProgress);
</script>
