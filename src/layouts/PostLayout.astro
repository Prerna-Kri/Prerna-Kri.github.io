---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/dates';
import { withBase } from '../lib/paths';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  date: Date | string;
  updated?: Date | string;
  tags?: string[];
  readingTime?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { title: string; slug: string };
  nextPost?: { title: string; slug: string };
}

const {
  title,
  description,
  date,
  updated,
  tags = [],
  readingTime = '4 min read',
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = formatDate(date);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: new Date(date).toISOString(),
  dateModified: updated ? new Date(updated).toISOString() : new Date(date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Prerna Kumari',
  },
};
---

<BaseLayout title={title} description={description} type="article" jsonLd={jsonLd}>
  <!-- Sticky reading progress bar at top of viewport per §7.7 -->
  <div class="fixed top-0 left-0 right-0 z-50 h-[2px] bg-transparent pointer-events-none" aria-hidden="true">
    <div id="reading-progress-bar" class="h-full w-0 bg-[var(--accent-signal)] transition-all duration-75"></div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-12 py-12 md:py-16">
    <!-- Main article container in columns 2-9 per §4.5 -->
    <article class="xl:col-start-2 xl:col-span-8 space-y-8 max-w-[68ch]">
      <header class="space-y-4 border-b border-[var(--border-subtle)] pb-8">
        <div class="flex flex-wrap items-center gap-3 text-[var(--step--1)] font-mono text-[var(--text-muted)]">
          <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span>{readingTime}</span>
        </div>

        <h1 class="font-display text-[var(--step-4)] text-[var(--text-heading)] leading-tight">
          {title}
        </h1>

        <p class="text-[var(--step-0)] text-[var(--text-muted)]">
          {description}
        </p>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {tags.map((tag) => (
              <span class="font-mono text-[11px] px-2 py-0.5 rounded-[3px] bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--text-muted)]">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Post Body (MDX) -->
      <div class="prose">
        <slot />
      </div>

      <!-- Prev / Next Navigation per §7.7 -->
      <nav aria-label="Post navigation" class="mt-16 pt-8 border-t border-[var(--border-subtle)] grid grid-cols-1 sm:grid-cols-2 gap-6 font-mono text-xs">
        {prevPost ? (
          <a
            href={withBase(`/writing/${prevPost.slug}`)}
            class="p-4 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-signal)] text-[var(--text-muted)] hover:text-[var(--text-heading)] transition-colors flex flex-col gap-1"
          >
            <span class="text-[10px] uppercase text-[var(--accent-signal)]">← Previous Post</span>
            <span class="font-sans font-medium text-sm text-[var(--text-heading)]">{prevPost.title}</span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={withBase(`/writing/${nextPost.slug}`)}
            class="p-4 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-signal)] text-[var(--text-muted)] hover:text-[var(--text-heading)] transition-colors flex flex-col gap-1 text-right sm:col-start-2"
          >
            <span class="text-[10px] uppercase text-[var(--accent-signal)]">Next Post →</span>
            <span class="font-sans font-medium text-sm text-[var(--text-heading)]">{nextPost.title}</span>
          </a>
        ) : <div />}
      </nav>
    </article>

    <!-- Marginal Sticky Table of Contents at xl and above per §7.7 -->
    {headings.length > 0 && (
      <aside class="hidden xl:block xl:col-span-3">
        <div class="sticky top-28 space-y-3 font-mono text-xs p-4 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)]/50">
          <div class="text-[10px] tracking-wider uppercase text-[var(--text-muted)] font-semibold border-b border-[var(--border-subtle)] pb-2">
            Table of Contents
          </div>
          <nav aria-label="Table of contents">
            <ul class="space-y-2">
              {headings.filter((h) => h.depth <= 3).map((h) => (
                <li class={h.depth === 3 ? 'pl-3 text-[11px]' : ''}>
                  <a
                    href={`#${h.slug}`}
                    class="text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors line-clamp-1"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    function update() {
      const scrollY = window.scrollY;
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const progress = total > 0 ? Math.min(100, Math.max(0, (scrollY / total) * 100)) : 0;
      bar!.style.width = `${progress}%`;
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  setupReadingProgress();
  document.addEventListener('astro:page-load', setupReadingProgress);
</script>
