---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/paths';
import SEO from '../components/common/SEO.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CommandPalette from '../components/common/CommandPalette.astro';
import '../styles/global.css';
import '../styles/print.css';

interface HighwireTags {
  title?: string;
  authors?: string[];
  publicationDate?: string;
  journalTitle?: string;
  conferenceTitle?: string;
  doi?: string;
  pdfUrl?: string;
}

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  type?: 'website' | 'article' | 'profile';
  ogImage?: string;
  highwire?: HighwireTags;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  isHome = false,
  type = 'website',
  ogImage,
  highwire,
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="dark" data-base-url={baseUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#120722" />
    <meta name="color-scheme" content="dark light" />

    <!-- Blocking inline script in <head> for zero-flash theme switching (§6) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          const metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute('content', theme === 'dark' ? '#120722' : '#FBF8FF');
          }
          const metaColor = document.querySelector('meta[name="color-scheme"]');
          if (metaColor) {
            metaColor.setAttribute('content', theme === 'dark' ? 'dark' : 'light');
          }
        } catch (_) {}
      })();
    </script>

    <SEO
      title={title}
      description={description}
      isHome={isHome}
      type={type}
      ogImage={ogImage}
      highwire={highwire}
      jsonLd={jsonLd}
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <!-- Privacy-respecting analytics placeholder per §13 (Zero cookies, commented out) -->
    <!--
    <script defer data-domain="prerna-kri.github.io" src="https://plausible.io/js/script.js"></script>
    -->

    <ClientRouter />
  </head>
  <body class="relative bg-[var(--bg-page)] text-[var(--text-body)] flex flex-col min-h-screen selection:bg-[var(--interactive)] selection:text-[#120722]">
    <SkipLink />

    <Header currentPath={currentPath} />

    <main id="main" class="flex-1 w-full relative z-10">
      <slot />
    </main>

    <Footer />
    <CommandPalette />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
      document.addEventListener('astro:page-load', () => initMotion());
    </script>
  </body>
</html>
