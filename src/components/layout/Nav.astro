---
import { withBase } from '../../lib/paths';
import { hasEntries } from '../../lib/collections';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const hasPubs = await hasEntries('publications');
const hasNotes = await hasEntries('writing');

const navItems: { href: string; label: string; raw: string }[] = [
  { href: withBase('/research'), label: 'Research', raw: '/research' },
  { href: withBase('/work'), label: 'Work', raw: '/work' },
];

if (hasPubs) {
  navItems.push({ href: withBase('/publications'), label: 'Publications', raw: '/publications' });
}

if (hasNotes) {
  navItems.push({ href: withBase('/writing'), label: 'Writing', raw: '/writing' });
}

navItems.push(
  { href: withBase('/cv'), label: 'CV', raw: '/cv' },
  { href: withBase('/#contact'), label: 'Contact', raw: '/#contact' }
);

function isActive(itemRaw: string): boolean {
  if (itemRaw === '/#contact') return false;
  if (currentPath === itemRaw || currentPath === `${itemRaw}/`) return true;
  if (itemRaw !== '/' && currentPath.startsWith(itemRaw)) return true;
  return false;
}
---

<nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-[var(--step--1)]">
  {
    navItems.map((item) => {
      const active = isActive(item.raw);
      return (
        <a
          href={item.href}
          class={`transition-colors py-1 relative ${
            active
              ? 'text-[var(--text-heading)] font-medium'
              : 'text-[var(--text-muted)] hover:text-[var(--text-heading)]'
          }`}
          aria-current={active ? 'page' : undefined}
        >
          {item.label}
          {active && (
            <span class="absolute -bottom-1 left-0 right-0 h-[2px] bg-[var(--interactive)]" />
          )}
        </a>
      );
    })
  }
</nav>
