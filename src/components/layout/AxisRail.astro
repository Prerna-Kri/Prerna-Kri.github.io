---
/**
 * Axis Rail per §4.5 & §6.2:
 * Behaves like the precision y-axis of a scientific figure.
 * Visible on lg screens (>= 1024px) with section ticks and scroll-progress data ramp.
 * Below 1024px, replaced by a top progress bar.
 */
interface Props {
  sections?: { id: string; label: string }[];
}

const { sections = [] } = Astro.props;
---

<!-- Mobile progress bar (< 1024px) -->
<div class="lg:hidden fixed top-[68px] left-0 right-0 z-30 h-[2px] bg-transparent pointer-events-none" aria-hidden="true">
  <div id="mobile-progress-bar" class="h-full w-0 bg-gradient-to-r from-[var(--accent-signal)] to-[var(--accent-pulse)] transition-all duration-75"></div>
</div>

<!-- Desktop Axis Rail (>= 1024px) -->
<aside
  id="axis-rail"
  class="hidden lg:flex fixed top-28 right-[clamp(1.25rem,4vw,3.5rem)] bottom-28 w-16 z-20 flex-col items-end pointer-events-none select-none font-mono text-[var(--step--1)] text-[var(--text-muted)]"
  aria-hidden="true"
>
  <!-- Vertical Hairline & Progress Track -->
  <div class="relative flex-1 w-[1px] bg-[var(--border-subtle)] mr-2">
    <!-- Scroll Progress Segment -->
    <div
      id="rail-progress-segment"
      class="absolute top-0 left-0 w-[2px] -ml-[0.5px] bg-gradient-to-b from-[var(--accent-signal)] to-[var(--accent-pulse)] origin-top scale-y-0 transition-transform duration-75"
    ></div>

    <!-- Section Tick Marks Container -->
    <div id="rail-ticks-container" class="absolute inset-0 flex flex-col justify-between py-6">
      {
        sections.map((sec) => (
          <div class="relative flex items-center justify-end group">
            <span
              class="tick-label mr-3 text-[10px] text-[var(--text-muted)] opacity-60 group-hover:opacity-100 transition-opacity whitespace-nowrap"
              data-tick-label={sec.id}
            >
              {sec.label}
            </span>
            <span
              class="tick-line block h-[1px] w-2 bg-[var(--border-strong)] transition-all duration-200 group-hover:w-4 group-hover:bg-[var(--accent-signal)]"
              data-tick-id={sec.id}
            ></span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-4 pr-2 text-[9px] text-[var(--text-muted)] tracking-widest uppercase opacity-70">
    Y-AXIS
  </div>
</aside>

<script>
  function setupAxisRail() {
    const mobileProgress = document.getElementById('mobile-progress-bar');
    const railProgress = document.getElementById('rail-progress-segment');
    const tickLines = document.querySelectorAll<HTMLElement>('.tick-line');
    const tickLabels = document.querySelectorAll<HTMLElement>('.tick-label');

    function updateScroll() {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollY / docHeight)) : 0;

      if (mobileProgress) {
        mobileProgress.style.width = `${progress * 100}%`;
      }
      if (railProgress) {
        railProgress.style.transform = `scaleY(${progress})`;
      }
    }

    // Observe sections to activate ticks (§6.2: tick grows from 8px to 16px and label crossfades)
    const observedSections = document.querySelectorAll<HTMLElement>('section[id], article[id]');
    if (observedSections.length > 0 && tickLines.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              const matchingTick = document.querySelector<HTMLElement>(`[data-tick-id="${id}"]`);
              const matchingLabel = document.querySelector<HTMLElement>(`[data-tick-label="${id}"]`);

              tickLines.forEach((t) => {
                t.style.width = '8px';
                t.style.backgroundColor = 'var(--border-strong)';
              });
              tickLabels.forEach((l) => {
                l.style.opacity = '0.6';
                l.style.color = 'var(--text-muted)';
              });

              if (matchingTick) {
                matchingTick.style.width = '16px';
                matchingTick.style.backgroundColor = 'var(--accent-signal)';
              }
              if (matchingLabel) {
                matchingLabel.style.opacity = '1';
                matchingLabel.style.color = 'var(--accent-signal)';
              }
            }
          });
        },
        { rootMargin: '-20% 0px -60% 0px' },
      );

      observedSections.forEach((sec) => observer.observe(sec));
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
  }

  setupAxisRail();
  document.addEventListener('astro:page-load', setupAxisRail);
</script>
