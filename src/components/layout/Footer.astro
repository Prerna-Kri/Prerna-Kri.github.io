---
import { site } from '../../config/site';
import { getActiveSocials } from '../../lib/config';
import { getBuildDate } from '../../lib/dates';
import Icon from '../common/Icon.astro';

const activeSocials = getActiveSocials();
const currentYear = new Date().getFullYear();
const lastUpdated = getBuildDate();
---

<footer id="footer" class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-well)] py-12 text-[var(--step--1)]">
  <div class="max-w-[1320px] mx-auto px-[clamp(1.25rem,5vw,5rem)]">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      <!-- Col 1: Statement (Cols 1-5) -->
      <div class="md:col-span-5 space-y-3">
        <div class="font-mono text-xs tracking-wider text-[var(--accent-signal)]">
          // RESEARCH STATEMENT
        </div>
        <p class="text-[var(--text-body)] leading-relaxed max-w-[45ch]">
          Developing robust deep learning frameworks and precision computer vision models for automated visual analysis and predictive decision-making.
        </p>
        <p class="text-[var(--text-muted)] text-xs">
          {site.department}, {site.institution}
        </p>
      </div>

      <!-- Col 2: Links (Cols 6-8) -->
      <div class="md:col-span-3 space-y-3">
        <div class="font-mono text-xs tracking-wider text-[var(--text-muted)]">
          // CONNECT
        </div>
        <ul class="space-y-1.5" role="list">
          {
            activeSocials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors"
                >
                  <Icon name={social.key === 'github' ? 'github' : social.key === 'linkedin' ? 'linkedin' : 'academic'} size={14} />
                  <span>{social.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${site.email}`}
              class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors"
            >
              <span>{site.email}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Metadata / Copyright (Cols 9-12) -->
      <div class="md:col-span-4 space-y-3 text-left md:text-right">
        <div class="font-mono text-xs tracking-wider text-[var(--text-muted)]">
          // METADATA
        </div>
        <p class="font-mono text-xs text-[var(--text-muted)]">
          Last updated: <time datetime={new Date().toISOString().split('T')[0]}>{lastUpdated}</time>
        </p>
        <p class="text-[var(--text-muted)]">
          &copy; {currentYear} {site.name}. All rights reserved.
        </p>
        <p class="text-xs text-[var(--text-muted)]">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--accent-signal)]">Astro</a>.
          Source on <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--accent-signal)]">GitHub</a>.
        </p>
      </div>
    </div>
  </div>
</footer>
