---
import { site } from '../../config/site';
import { getActiveSocials } from '../../lib/config';
import { getBuildDate } from '../../lib/dates';
import Icon from '../common/Icon.astro';

const activeSocials = getActiveSocials();
const currentYear = new Date().getFullYear();
const lastUpdated = getBuildDate();
---

<footer id="footer" class="bleed mt-auto border-t border-[var(--border-hairline)] bg-[var(--bg-well)] py-16 text-[var(--step--1)]">
  <div class="frame space-y-12">
    <!-- Full Name in Archivo at --step-4 spanning width per §7 -->
    <div
      class="text-[var(--step-4)] font-bold text-[var(--text-heading)] tracking-tight leading-none"
      style="font-family: var(--font-display); font-stretch: 125%; font-weight: 700;"
    >
      {site.name}
    </div>

    <!-- Three columns below per §7 -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 pt-6 border-t border-[var(--border-hairline)]">
      <!-- Col 1: Statement (Cols 1-5) -->
      <div class="md:col-span-5 space-y-2">
        <p class="text-[var(--text-body)] leading-relaxed max-w-[45ch]">
          {site.tagline}
        </p>
        <p class="text-[var(--text-muted)] text-xs">
          {site.lab}, {site.institution} · {site.location}
        </p>
      </div>

      <!-- Col 2: Configured links only (Cols 6-8) -->
      <div class="md:col-span-3 space-y-2">
        <div class="text-xs font-medium text-[var(--text-heading)]">Links</div>
        <ul class="space-y-1.5" role="list">
          {
            activeSocials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--interactive)] transition-colors"
                >
                  <Icon name={social.key === 'github' ? 'github' : social.key === 'linkedin' ? 'linkedin' : 'academic'} size={14} />
                  <span>{social.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${site.email}`}
              class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--interactive)] transition-colors"
            >
              <span>{site.email}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Last updated, Copyright, Source (Cols 9-12) -->
      <div class="md:col-span-4 space-y-2 text-left md:text-right">
        <div class="text-xs font-medium text-[var(--text-heading)]">Build</div>
        <p class="font-mono text-xs text-[var(--text-muted)]">
          Last updated: <time datetime={new Date().toISOString().split('T')[0]}>{lastUpdated}</time>
        </p>
        <p class="text-[var(--text-muted)]">
          &copy; {site.name} {currentYear}
        </p>
        <p class="text-xs text-[var(--text-muted)]">
          <a
            href={site.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--interactive)] transition-colors underline"
          >
            Source on GitHub
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
