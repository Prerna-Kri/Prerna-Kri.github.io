---
import { site } from '../../config/site';
import { withBase } from '../../lib/paths';
import Nav from './Nav.astro';
import MobileNav from './MobileNav.astro';
import ThemeToggle from '../common/ThemeToggle.astro';
import Icon from '../common/Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 w-full h-[64px] transition-all duration-300"
>
  <div class="frame h-full flex items-center justify-between">
    <!-- Left: Initials mark in Archivo 700 width 125 + Full name beside it -->
    <a
      href={withBase('/')}
      class="inline-flex items-baseline gap-2 text-[var(--text-heading)] hover:text-[var(--interactive)] transition-colors py-1"
      aria-label={`${site.name} — Home`}
    >
      <span
        class="text-xl font-bold tracking-tight text-[var(--text-heading)]"
        style="font-family: var(--font-display); font-stretch: 125%; font-weight: 700;"
      >
        {site.initials}
      </span>
      <span class="hidden sm:inline text-[var(--step-0)] text-[var(--text-body)] font-normal">
        {site.name}
      </span>
    </a>

    <!-- Right: Nav, Theme toggle, ⌘K affordance, Mobile menu button -->
    <div class="flex items-center gap-4 sm:gap-6">
      <Nav currentPath={currentPath} />

      <!-- Command Palette Affordance (Ctrl+K) -->
      <button
        type="button"
        data-command-palette-trigger
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 text-[var(--step--1)] rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] text-[var(--text-muted)] hover:text-[var(--text-heading)] hover:border-[var(--border-emphasis)] transition-colors cursor-pointer"
        aria-label="Open command palette (Ctrl+K)"
        title="Open command palette (Ctrl+K)"
      >
        <Icon name="search" size={14} />
        <span class="text-xs">Search</span>
        <kbd class="font-mono text-[10px] px-1 py-0.5 rounded bg-[var(--bg-surface)] border border-[var(--border-hairline)]">⌘K</kbd>
      </button>

      <ThemeToggle />

      <MobileNav currentPath={currentPath} />
    </div>
  </div>

  <!-- Scroll Progress Line (§5.2, §7) -->
  <div id="header-scroll-progress" class="scroll-progress-bar" aria-hidden="true"></div>
</header>

<script>
  function handleHeaderScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    if (window.scrollY > 120) {
      header.classList.add(
        'backdrop-blur-[14px]',
        'bg-[#120722]/74',
        'border-b',
        'border-[var(--border-hairline)]',
        'shadow-md'
      );
    } else {
      header.classList.remove(
        'backdrop-blur-[14px]',
        'bg-[#120722]/74',
        'border-b',
        'border-[var(--border-hairline)]',
        'shadow-md'
      );
    }

    // Scroll progress line
    const progressEl = document.getElementById('header-scroll-progress');
    if (progressEl) {
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollTotal > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollTotal)) : 0;
      progressEl.style.transform = `scaleX(${progress})`;
    }
  }

  window.addEventListener('scroll', handleHeaderScroll, { passive: true });
  handleHeaderScroll();
  document.addEventListener('astro:page-load', handleHeaderScroll);
</script>
