---
import Icon from '../common/Icon.astro';

interface Props {
  href: string;
  label: string;
  icon?: 'file-text' | 'arrow-up-right' | 'code';
}

const { href, label, icon } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1 font-mono text-[11px] px-2 py-0.5 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent-signal)] hover:border-[var(--accent-signal)] transition-colors"
>
  {icon && <Icon name={icon} size={11} />}
  <span>{label}</span>
</a>
