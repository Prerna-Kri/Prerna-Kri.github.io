---
import CopyButton from '../common/CopyButton.astro';

interface Props {
  bibtex: string;
  id?: string;
  class?: string;
}

const { bibtex, id = `bibtex-${Math.random().toString(36).substring(2, 8)}`, class: className = '' } = Astro.props;
---

<div class={`bibtex-box relative overflow-hidden ${className}`}>
  <div class="flex items-center justify-between pb-2 mb-2 border-b border-[var(--border-subtle)]/60 text-[10px] uppercase text-[var(--text-muted)]">
    <span>BibTeX Entry</span>
    <CopyButton targetSelector={`#${id}`} label="Copy BibTeX" />
  </div>
  <pre class="overflow-x-auto text-[var(--text-body)] leading-relaxed select-all"><code id={id}>{bibtex.trim()}</code></pre>
</div>
