---
import CopyButton from '../common/CopyButton.astro';
import { formatApaCitation, formatIeeeCitation } from '../../lib/cite';

interface Props {
  pub: {
    title: string;
    authors: string[];
    year: number;
    venue: string;
    doi?: string;
    arxiv?: string;
  };
}

const { pub } = Astro.props;
const apa = formatApaCitation(pub);
const ieee = formatIeeeCitation(pub);
---

<div class="space-y-4 border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-[4px] p-4 text-xs font-mono">
  <div class="font-mono text-xs uppercase tracking-wider text-[var(--accent-signal)] font-semibold border-b border-[var(--border-subtle)] pb-2">
    Cite This Work
  </div>

  <div class="space-y-2">
    <div class="flex items-center justify-between text-[10px] uppercase text-[var(--text-muted)]">
      <span>APA</span>
      <CopyButton text={apa} label="Copy APA" />
    </div>
    <p class="font-sans text-xs text-[var(--text-body)] leading-relaxed select-all">
      {apa}
    </p>
  </div>

  <div class="space-y-2 pt-2 border-t border-[var(--border-subtle)]/50">
    <div class="flex items-center justify-between text-[10px] uppercase text-[var(--text-muted)]">
      <span>IEEE</span>
      <CopyButton text={ieee} label="Copy IEEE" />
    </div>
    <p class="font-sans text-xs text-[var(--text-body)] leading-relaxed select-all">
      {ieee}
    </p>
  </div>
</div>
