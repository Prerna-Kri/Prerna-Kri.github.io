---
import Icon from '../common/Icon.astro';

interface Props {
  topics?: { slug: string; label: string }[];
  totalCount?: number;
}

const {
  topics = [
    { slug: 'computer-vision', label: 'Computer Vision' },
    { slug: 'deep-learning', label: 'Deep Learning' },
    { slug: 'predictive-analytics', label: 'Predictive Analytics' },
    { slug: 'mathematical-foundations', label: 'Mathematical Foundations' },
  ],
  totalCount = 0,
} = Astro.props;

const types = [
  { slug: 'all', label: 'All' },
  { slug: 'journal', label: 'Journal' },
  { slug: 'conference', label: 'Conference' },
  { slug: 'preprint', label: 'Preprint' },
  { slug: 'workshop', label: 'Workshop' },
  { slug: 'thesis', label: 'Thesis' },
];
---

<div id="pub-filter-controls" class="space-y-4 border border-[var(--border-subtle)] bg-[var(--bg-well)] rounded-[4px] p-4 font-mono text-xs">
  <!-- Top row: Search input & Sort toggle -->
  <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
    <div class="relative flex-1">
      <Icon name="search" size={14} class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)]" />
      <input
        id="pub-search-input"
        type="search"
        placeholder="Filter by title, venue, or author..."
        class="w-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[4px] pl-9 pr-3 py-1.5 text-xs text-[var(--text-heading)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-signal)]"
        aria-label="Filter publications by title, venue, or author"
      />
    </div>

    <button
      id="pub-sort-toggle"
      type="button"
      class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-heading)] transition-colors cursor-pointer shrink-0"
      aria-label="Toggle sort order"
    >
      <span class="sort-label">Newest First</span>
    </button>
  </div>

  <!-- Type filter pills (rounded-[999px] per §4.5) -->
  <div class="space-y-1.5">
    <div class="text-[10px] uppercase text-[var(--text-muted)] tracking-wider">
      Publication Type
    </div>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by type">
      {
        types.map((t) => (
          <button
            type="button"
            data-filter-type={t.slug}
            aria-pressed={t.slug === 'all' ? 'true' : 'false'}
            class={`filter-pill px-3 py-1 rounded-[999px] border transition-all cursor-pointer ${
              t.slug === 'all' ? 'active-filter' : ''
            }`}
          >
            {t.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Topic filter pills (rounded-[999px] per §4.5) -->
  <div class="space-y-1.5 pt-1 border-t border-[var(--border-subtle)]/40">
    <div class="text-[10px] uppercase text-[var(--text-muted)] tracking-wider">
      Topic Area
    </div>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by topic">
      <button
        type="button"
        data-filter-topic="all"
        aria-pressed="true"
        class="filter-pill active-filter px-3 py-1 rounded-[999px] border transition-all cursor-pointer"
      >
        All Topics
      </button>
      {
        topics.map((tp) => (
          <button
            type="button"
            data-filter-topic={tp.slug}
            aria-pressed="false"
            class="filter-pill px-3 py-1 rounded-[999px] border transition-all cursor-pointer"
          >
            {tp.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Live region for accessibility announcements per §10 -->
  <div id="pub-results-live" class="sr-only" aria-live="polite">
    Showing all {totalCount} publications
  </div>
</div>

<script>
  import { initPublicationFilter } from '../../scripts/filter';
  initPublicationFilter();
  document.addEventListener('astro:page-load', initPublicationFilter);
</script>
