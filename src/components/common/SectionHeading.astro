---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  class?: string;
}

const { title, subtitle, tag, class: className = '' } = Astro.props;
---

<div class={`space-y-1.5 border-t border-[var(--border-subtle)] pt-6 ${className}`}>
  {tag && (
    <div class="font-mono text-xs uppercase tracking-widest text-[var(--accent-signal)]">
      // {tag}
    </div>
  )}
  <h2 class="font-display text-[var(--step-3)] text-[var(--text-heading)]">
    {title}
  </h2>
  {subtitle && (
    <p class="text-[var(--step--1)] text-[var(--text-muted)] max-w-[60ch]">
      {subtitle}
    </p>
  )}
</div>
