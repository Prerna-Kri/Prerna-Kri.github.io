---
interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  class?: string;
}

const { title, subtitle, class: className = '' } = Astro.props;
---

<div class={`space-y-2 border-t border-subtle pt-6 ${className}`}>
  <h2 class="font-display step-3 text-heading">
    {title}
  </h2>
  {subtitle && (
    <p class="step--1 text-muted max-w-[60ch] leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
