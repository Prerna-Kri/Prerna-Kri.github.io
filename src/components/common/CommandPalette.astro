---
import Icon from './Icon.astro';
---

<div
  id="command-palette-modal"
  class="fixed inset-0 z-50 flex items-start justify-center pt-[15vh] px-4 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Command Palette"
  aria-hidden="true"
>
  <!-- Backdrop overlay -->
  <div
    id="command-palette-backdrop"
    class="fixed inset-0 bg-black/70 backdrop-blur-sm"
    aria-hidden="true"
  ></div>

  <!-- Modal Dialog -->
  <div class="relative w-full max-w-xl bg-[var(--bg-well)] border border-[var(--border-strong)] rounded-[6px] shadow-[var(--floating-shadow)] overflow-hidden flex flex-col z-10">
    <!-- Search Input Header -->
    <div class="flex items-center px-4 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
      <Icon name="search" size={18} class="text-[var(--text-muted)] mr-3" />
      <input
        id="command-palette-input"
        type="text"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="command-palette-results"
        placeholder="Type a command or search (e.g., 'publications', 'cv', 'email')..."
        class="w-full bg-transparent text-[var(--step-0)] text-[var(--text-heading)] placeholder:text-[var(--text-muted)] font-mono outline-none"
      />
      <kbd class="hidden sm:inline-block font-mono text-[10px] px-1.5 py-0.5 rounded border border-[var(--border-subtle)] text-[var(--text-muted)] bg-[var(--bg-well)]">ESC</kbd>
    </div>

    <!-- Live region for screen reader announcements per §9 & §10 -->
    <div id="command-palette-live" class="sr-only" aria-live="polite"></div>

    <!-- Results List -->
    <ul
      id="command-palette-results"
      role="listbox"
      class="max-h-[50vh] overflow-y-auto p-2 space-y-1 divide-y divide-[var(--border-subtle)]/30"
    >
      <!-- Populated dynamically via palette.ts -->
    </ul>

    <!-- Footer Controls -->
    <div class="px-4 py-2 border-t border-[var(--border-subtle)] bg-[var(--bg-surface)]/50 flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
      <div class="flex items-center gap-3">
        <span><kbd class="border border-[var(--border-subtle)] px-1 rounded">↑↓</kbd> navigate</span>
        <span><kbd class="border border-[var(--border-subtle)] px-1 rounded">↵</kbd> select</span>
      </div>
      <span><kbd class="border border-[var(--border-subtle)] px-1 rounded">/</kbd> quick focus</span>
    </div>
  </div>
</div>

<script>
  import { initCommandPalette } from '../../scripts/palette';
  initCommandPalette();
  document.addEventListener('astro:page-load', initCommandPalette);
</script>
