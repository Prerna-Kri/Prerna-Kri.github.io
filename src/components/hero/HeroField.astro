---
/**
 * Canvas container for hero embedding field per §6.1.
 * aria-hidden="true" and role="presentation" per §10.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`absolute inset-0 overflow-hidden pointer-events-auto ${className}`} aria-hidden="true" role="presentation">
  <canvas id="hero-canvas" class="w-full h-full block"></canvas>
</div>

<script>
  import { initHeroField } from '../../scripts/heroField';
  let cleanup: (() => void) | null = null;

  function run() {
    if (cleanup) cleanup();
    cleanup = initHeroField('hero-canvas');
  }

  run();
  document.addEventListener('astro:page-load', run);
</script>
