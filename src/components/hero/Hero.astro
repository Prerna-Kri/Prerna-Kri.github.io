---
import { site } from '../../config/site';
import { withBase } from '../../lib/paths';
import HeroField from './HeroField.astro';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';

// Composed role line without banned middle-dot formatting (§4.2 & §7.1)
const roleLine = `${site.role} at ${site.institution}, focusing on ${site.researchAreas[0].toLowerCase()}`;
---

<section id="hero" class="relative min-h-[88vh] flex flex-col justify-center py-16 sm:py-24 overflow-hidden">
  <!-- Signature moment: Hand-written 2D Canvas background per §6.1 -->
  <HeroField />

  <!-- Hero Content Container (Columns 2-9 per §4.5) -->
  <div class="relative z-10 space-y-8 max-w-[850px] pointer-events-none">
    <!-- Monogram and Status -->
    <div class="inline-flex items-center gap-2 font-mono text-xs text-signal pointer-events-auto bg-well/90 px-3 py-1.5 rounded-[4px] border border-subtle backdrop-blur-md shadow-sm">
      <span class="w-2 h-2 rounded-full bg-signal animate-pulse"></span>
      <span class="tracking-wide">{site.department}, {site.institution}</span>
    </div>

    <!-- Headline revealed with line-clipping per §6.1 -->
    <div class="overflow-hidden py-1">
      <h1 class="hero-headline font-display step-6 text-heading leading-[1.04] tracking-tight pointer-events-auto">
        <span class="block line-reveal">{site.name}</span>
      </h1>
    </div>

    <!-- Role and Tagline per §7.1 -->
    <div class="space-y-3 pointer-events-auto">
      <p class="font-sans step-1 text-mist-200 font-medium tracking-normal">
        {roleLine}
      </p>
      <p class="font-sans step-1 text-body leading-relaxed max-w-[30ch]">
        {site.tagline}
      </p>
    </div>

    <!-- Action Buttons & Availability line per §7.1 -->
    <div class="space-y-5 pt-2 pointer-events-auto">
      <div class="flex flex-wrap items-center gap-4">
        <Button href={withBase('/research')} variant="primary" isMagnetic={true}>
          Read the research
        </Button>
        <Button href={withBase(site.cvPdf)} variant="secondary" target="_blank" rel="noopener noreferrer">
          <Icon name="file-text" size={16} />
          <span>Download CV</span>
        </Button>
      </div>

      <!-- Availability status -->
      <div class="font-mono text-xs text-muted flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-signal opacity-70"></span>
        <span>Open to: {site.openTo}</span>
      </div>
    </div>
  </div>
</section>
