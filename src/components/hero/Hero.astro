---
import { site } from '../../config/site';
import { withBase } from '../../lib/paths';
import HeroField from './HeroField.astro';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';

const roleLine = `${site.role} · ${site.institution} · ${site.researchAreas[0]}`;
---

<section id="hero" class="relative min-h-[88vh] flex flex-col justify-center py-16 sm:py-24 overflow-hidden">
  <!-- Signature moment: Hand-written 2D Canvas background per §6.1 -->
  <HeroField />

  <!-- Hero Content Container (Columns 2-9 per §4.5) -->
  <div class="relative z-10 space-y-8 max-w-[850px] pointer-events-none">
    <!-- Monogram and Status -->
    <div class="inline-flex items-center gap-2 font-mono text-xs text-[var(--accent-signal)] pointer-events-auto bg-[var(--bg-well)]/80 px-2.5 py-1 rounded-[4px] border border-[var(--border-subtle)] backdrop-blur-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-signal)] animate-pulse"></span>
      <span>{site.department}, {site.institution}</span>
    </div>

    <!-- Headline revealed with line-clipping per §6.1 -->
    <div class="overflow-hidden">
      <h1 class="hero-headline font-display text-[var(--step-6)] text-[var(--text-heading)] leading-[0.98] tracking-tight pointer-events-auto">
        <span class="block line-reveal">{site.name}</span>
      </h1>
    </div>

    <!-- Role and Tagline -->
    <div class="space-y-3 pointer-events-auto">
      <p class="font-sans text-[var(--step-1)] text-[var(--text-muted)] font-medium">
        {roleLine}
      </p>
      <p class="font-sans text-[var(--step-1)] text-[var(--text-body)] leading-relaxed max-w-[30ch]">
        {site.tagline}
      </p>
    </div>

    <!-- Action Buttons & Availability line per §7.1 -->
    <div class="space-y-4 pt-2 pointer-events-auto">
      <div class="flex flex-wrap items-center gap-4">
        <Button href={withBase('/research')} variant="primary" isMagnetic={true}>
          Read the research
        </Button>
        <Button href={withBase(site.cvPdf)} variant="secondary" target="_blank" rel="noopener noreferrer">
          <Icon name="file-text" size={16} />
          <span>Download CV</span>
        </Button>
      </div>

      <!-- Availability status -->
      <div class="font-mono text-xs text-[var(--text-muted)] flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-signal)]/60"></span>
        <span>Open to: {site.openTo}</span>
      </div>
    </div>
  </div>
</section>


