---
interface Props {
  stack: string[];
  class?: string;
}

const { stack, class: className = '' } = Astro.props;
---

<div class={`flex flex-wrap gap-1.5 font-mono text-[11px] ${className}`}>
  {
    stack.map((tech) => (
      <span class="px-2 py-0.5 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-well)] text-[var(--text-muted)]">
        {tech}
      </span>
    ))
  }
</div>
