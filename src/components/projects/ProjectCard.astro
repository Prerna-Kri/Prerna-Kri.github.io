---
import StackTags from './StackTags.astro';
import Tag from '../common/Tag.astro';
import Icon from '../common/Icon.astro';

interface Props {
  project: {
    id: string;
    data: {
      name: string;
      summary: string;
      description: string;
      stack: string[];
      role: string;
      status: 'active' | 'archived' | 'paper-accompanying';
      year: number;
      repo?: string;
      demo?: string;
      paper?: string;
      image?: string;
      featured: boolean;
    };
  };
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const d = project.data;

const statusBadges = {
  active: 'accent',
  'paper-accompanying': 'amber',
  archived: 'mono',
} as const;
---

<article class="project-card border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-[10px] p-5 sm:p-6 flex flex-col justify-between space-y-6 hover:border-[var(--border-strong)] transition-colors">
  <div class="space-y-4">
    <!-- 16:10 Figure Frame per §7.1 & §7.4 (square corners, 1px border) -->
    <div class="aspect-[16/10] w-full border border-[var(--border-subtle)] bg-[var(--bg-well)] rounded-[0px] p-4 flex flex-col justify-between relative overflow-hidden group">
      <!-- Faint geometric schematic representing precision instrument -->
      <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(var(--accent-signal) 1px, transparent 1px); background-size: 16px 16px;"></div>

      <div class="flex items-center justify-between z-10 font-mono text-[10px] text-[var(--text-muted)]">
        <span>FIG. {d.year} // {d.status.toUpperCase()}</span>
        <Tag variant={statusBadges[d.status]}>
          {d.status}
        </Tag>
      </div>

      <div class="z-10 text-center py-4">
        <div class="font-mono text-xs text-[var(--accent-signal)] tracking-widest uppercase">
          {d.stack[0] || 'ENGINEERING'}
        </div>
        <div class="font-display text-[var(--step-1)] text-[var(--text-heading)] mt-1">
          {d.name}
        </div>
      </div>

      <div class="flex items-center justify-between z-10 font-mono text-[10px] text-[var(--text-muted)] border-t border-[var(--border-subtle)]/40 pt-1.5">
        <span>ROLE: {d.role}</span>
        <span>YEAR: {d.year}</span>
      </div>
    </div>

    <!-- Project info -->
    <div class="space-y-2">
      <h3 class="font-display text-[var(--step-2)] text-[var(--text-heading)]">
        {d.name}
      </h3>
      <p class="text-[var(--step--1)] text-[var(--text-muted)] font-medium">
        {d.summary}
      </p>
      {!compact && (
        <p class="text-[var(--step--1)] text-[var(--text-body)] leading-relaxed pt-1">
          {d.description}
        </p>
      )}
    </div>
  </div>

  <div class="space-y-4 pt-4 border-t border-[var(--border-subtle)]/60">
    <StackTags stack={d.stack} />

    <!-- Action Links -->
    <div class="flex flex-wrap items-center gap-3 pt-1 text-xs font-mono">
      {d.repo && (
        <a
          href={d.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors"
        >
          <Icon name="code" size={13} />
          <span>Source Code</span>
        </a>
      )}
      {d.paper && (
        <a
          href={d.paper}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors"
        >
          <Icon name="file-text" size={13} />
          <span>Paper</span>
        </a>
      )}
      {d.demo && (
        <a
          href={d.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--accent-signal)] transition-colors"
        >
          <Icon name="arrow-up-right" size={13} />
          <span>Demo / Details</span>
        </a>
      )}
    </div>
  </div>
</article>
