---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PubFilter from '../../components/publications/PubFilter.astro';
import PubList from '../../components/publications/PubList.astro';
import CopyButton from '../../components/common/CopyButton.astro';
import Icon from '../../components/common/Icon.astro';
import { site } from '../../config/site';
import { isPlaceholder } from '../../lib/config';

const allPublications = await getCollection('publications');

// Distinct topics
const topicsList = [
  { slug: 'computer-vision', label: 'Computer Vision' },
  { slug: 'deep-learning', label: 'Deep Learning' },
  { slug: 'predictive-analytics', label: 'Predictive Analytics' },
  { slug: 'mathematical-foundations', label: 'Mathematical Foundations' },
];

const hasScholar = !isPlaceholder(site.socials.scholar);
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed conference proceedings, journal papers, preprints, and workshop contributions by Prerna Kumari."
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-y-8 md:gap-x-6 py-12 md:py-16">
    <div class="md:col-start-2 md:col-span-8 space-y-10">

      <!-- Header & Page Actions per §7.3 -->
      <header class="space-y-4 border-b border-[var(--border-subtle)] pb-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h1 class="font-display text-[var(--step-5)] text-[var(--text-heading)] tracking-tight">
              Publications
            </h1>
            <p class="text-[var(--step-0)] text-[var(--text-muted)] mt-1">
              Peer-reviewed articles, conference proceedings, and mathematical preprints.
            </p>
          </div>

          <!-- Page-level actions per §7.3 -->
          <div class="flex items-center gap-3 shrink-0">
            <CopyButton targetSelector="[id^='bibtex-code-']" label="Copy All BibTeX" />

            {hasScholar && (
              <a
                href={site.socials.scholar}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent-signal)] hover:border-[var(--accent-signal)] transition-colors font-mono text-xs"
              >
                <Icon name="academic" size={13} />
                <span>Google Scholar</span>
              </a>
            )}
          </div>
        </div>
      </header>

      <!-- Interactive Filter Controls per §7.3 -->
      <PubFilter topics={topicsList} totalCount={allPublications.length} />

      <!-- Publications List grouped by Year with Sticky Year Markers per §7.3 -->
      <PubList publications={allPublications} groupByYear={true} />

    </div>
  </div>
</BaseLayout>
