---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/common/Tag.astro';
import LinkChip from '../../components/publications/LinkChip.astro';
import BibtexBlock from '../../components/publications/BibtexBlock.astro';
import CiteBlock from '../../components/publications/CiteBlock.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((pub) => {
    const slug = pub.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug },
      props: { pub },
    };
  });
}

const { pub } = Astro.props;
const d = pub.data;

// Highwire Press tags for Google Scholar indexing per §12
const highwire = {
  title: d.title,
  authors: d.authors,
  publicationDate: new Date(d.date).toISOString().split('T')[0],
  journalTitle: d.type === 'journal' ? d.venue : undefined,
  conferenceTitle: d.type === 'conference' ? d.venue : undefined,
  doi: d.doi,
  pdfUrl: d.pdf,
};

// ScholarlyArticle JSON-LD per §12
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  name: d.title,
  author: d.authors.map((a) => ({
    '@type': 'Person',
    name: a,
  })),
  datePublished: new Date(d.date).toISOString(),
  description: d.abstract,
  sameAs: d.doi ? `https://doi.org/${d.doi}` : undefined,
};
---

<BaseLayout
  title={d.title}
  description={d.abstract.slice(0, 160)}
  highwire={highwire}
  jsonLd={jsonLd}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-y-8 md:gap-x-6 py-12 md:py-16">
    <article class="md:col-start-2 md:col-span-8 space-y-10">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="font-mono text-xs text-[var(--text-muted)]">
        <a href={withBase('/publications')} class="hover:text-[var(--accent-signal)] underline">
          ← All Publications
        </a>
      </nav>

      <!-- Paper Header -->
      <header class="space-y-4 border-b border-[var(--border-subtle)] pb-8">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
          <span class="text-[var(--text-heading)] font-semibold">{d.year}</span>
          <span>·</span>
          <span>{d.venue}</span>
          {d.award && <Tag variant="amber">★ {d.award}</Tag>}
          {d.status === 'preprint' && <Tag variant="mono">Preprint</Tag>}
        </div>

        <h1 class="font-display text-[var(--step-4)] text-[var(--text-heading)] leading-tight">
          {d.title}
        </h1>

        <!-- Authors list -->
        <p class="text-[var(--step-0)] text-[var(--text-body)] leading-relaxed">
          {
            d.authors.map((author, index) => {
              const isMe = author.toLowerCase().includes('kumari') || author.toLowerCase().includes('prerna');
              return (
                <span>
                  <strong class={isMe ? 'text-[var(--text-heading)] font-semibold underline decoration-[var(--accent-signal)]/40' : 'text-[var(--text-muted)]'}>
                    {author}
                  </strong>
                  {index < d.authors.length - 1 && ', '}
                </span>
              );
            })
          }
        </p>

        <!-- Direct resource links -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          {d.pdf && <LinkChip href={d.pdf} label="Read PDF" icon="file-text" />}
          {d.doi && <LinkChip href={`https://doi.org/${d.doi}`} label={`DOI: ${d.doi}`} />}
          {d.arxiv && <LinkChip href={`https://arxiv.org/abs/${d.arxiv}`} label={`arXiv:${d.arxiv}`} />}
          {d.code && <LinkChip href={d.code} label="Source Code" icon="code" />}
          {d.data && <LinkChip href={d.data} label="Dataset" />}
          {d.poster && <LinkChip href={d.poster} label="Conference Poster" />}
          {d.slides && <LinkChip href={d.slides} label="Presentation Slides" />}
          {d.video && <LinkChip href={d.video} label="Presentation Video" />}
        </div>
      </header>

      <!-- Abstract Section -->
      <section class="space-y-3">
        <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--accent-signal)]">
          // Abstract
        </h2>
        <p class="text-[var(--step-0)] text-[var(--text-body)] leading-relaxed measure-reading">
          {d.abstract}
        </p>
      </section>

      <!-- Citation Section (APA & IEEE) per §7.3 -->
      <section class="space-y-3">
        <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--accent-signal)]">
          // Formatted Citations
        </h2>
        <CiteBlock pub={d} />
      </section>

      <!-- Full BibTeX Block per §7.3 -->
      <section class="space-y-3">
        <h2 class="font-mono text-xs uppercase tracking-widest text-[var(--accent-signal)]">
          // BibTeX Export
        </h2>
        <BibtexBlock bibtex={d.bibtex} />
      </section>

    </article>
  </div>
</BaseLayout>
