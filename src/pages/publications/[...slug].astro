---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyButton from '../../components/common/CopyButton.astro';
import { site } from '../../config/site';
import { isSet } from '../../lib/config';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  // §7.4 & §18: Gated strictly by non-empty collection
  if (publications.length === 0) {
    return [];
  }

  const paths = [
    {
      params: { slug: undefined },
      props: { isIndex: true, pub: null, allPublications: publications },
    },
    ...publications.map((pub) => {
      const slug = pub.id.replace(/\.[^/.]+$/, '');
      return {
        params: { slug },
        props: { isIndex: false, pub, allPublications: publications },
      };
    }),
  ];

  return paths;
}

const { isIndex, pub, allPublications } = Astro.props;
const hasScholar = isSet(site.socials.scholar);
---

{
  isIndex ? (
    <BaseLayout
      title="Publications"
      description={`Peer-reviewed publications, conference proceedings, and preprints by ${site.name}.`}
    >
      <div class="frame pt-28 pb-20 space-y-12">
        <header class="border-b border-[var(--border-hairline)] pb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <div class="space-y-2 max-w-[70ch]">
            <h1
              class="text-[var(--step-4)] sm:text-[var(--step-5)] font-bold text-[var(--text-heading)] tracking-tight"
              style="font-family: var(--font-display); font-weight: 700;"
            >
              Publications
            </h1>
            <p class="text-[var(--step-1)] text-[var(--text-body)]">
              Peer-reviewed articles, workshops, and preprints.
            </p>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            {hasScholar && (
              <a
                href={site.socials.scholar}
                target="_blank"
                rel="noopener noreferrer"
                class="link-volt font-mono text-xs"
              >
                Google Scholar &rarr;
              </a>
            )}
          </div>
        </header>

        <div class="divide-y divide-[var(--border-hairline)] border-y border-[var(--border-hairline)] max-w-[70ch]">
          {allPublications?.map((p: any) => (
            <article class="py-8 space-y-3">
              <div class="flex items-center gap-3 font-mono text-xs text-[var(--text-muted)]">
                <span>{p.data.year}</span>
                <span>·</span>
                <span class="capitalize text-[var(--interactive)]">{p.data.type}</span>
              </div>

              <h2
                class="text-[var(--step-1)] font-bold text-[var(--text-heading)] leading-snug"
                style="font-family: var(--font-display); font-weight: 700;"
              >
                <a href={withBase(`/publications/${p.id.replace(/\.[^/.]+$/, '')}`)}>
                  {p.data.title}
                </a>
              </h2>

              <p class="text-[var(--step-0)] text-[var(--text-body)]">
                {p.data.abstract}
              </p>
            </article>
          ))}
        </div>
      </div>
    </BaseLayout>
  ) : pub ? (
    <BaseLayout
      title={pub.data.title}
      description={pub.data.abstract.slice(0, 160)}
    >
      <div class="frame pt-28 pb-20 space-y-10 max-w-[70ch]">
        <nav class="font-mono text-xs text-[var(--text-muted)]">
          <a href={withBase('/publications')} class="hover:text-[var(--interactive)]">
            &larr; All Publications
          </a>
        </nav>

        <header class="space-y-4 border-b border-[var(--border-hairline)] pb-8">
          <span class="font-mono text-xs uppercase px-2.5 py-1 rounded-[4px] bg-[var(--bg-well)] border border-[var(--border-hairline)] text-[var(--interactive)]">
            {pub.data.type}
          </span>

          <h1
            class="text-[var(--step-3)] sm:text-[var(--step-4)] font-bold text-[var(--text-heading)] leading-snug"
            style="font-family: var(--font-display); font-weight: 700;"
          >
            {pub.data.title}
          </h1>

          <div class="text-[var(--step-0)] text-[var(--text-muted)]">
            {pub.data.authors.join(', ')}
          </div>

          <div class="font-mono text-xs text-[var(--text-muted)]">
            {pub.data.venue} · {pub.data.year}
          </div>
        </header>

        <div class="space-y-4">
          <h2 class="font-mono text-xs uppercase text-[var(--text-muted)] tracking-wider">
            Abstract
          </h2>
          <p class="text-[var(--step-0)] text-[var(--text-body)] leading-relaxed">
            {pub.data.abstract}
          </p>
        </div>

        {pub.data.bibtex && (
          <div class="space-y-3 pt-6 border-t border-[var(--border-hairline)]">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs uppercase text-[var(--text-muted)] tracking-wider">
                BibTeX
              </span>
              <CopyButton text={pub.data.bibtex} label="Copy BibTeX" />
            </div>
            <pre class="p-4 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] overflow-x-auto font-mono text-xs text-[var(--text-muted)]">
              <code>{pub.data.bibtex}</code>
            </pre>
          </div>
        )}
      </div>
    </BaseLayout>
  ) : null
}
