---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/common/TableOfContents.astro';
import Figure from '../components/common/Figure.astro';

const directions = await getCollection('directions');
const sortedDirections = directions.sort((a, b) => a.data.order - b.data.order);

const allProjects = await getCollection('projects');

const tocHeadings = sortedDirections.map((d) => ({
  id: d.data.slug,
  label: d.data.title,
}));
---

<BaseLayout
  title="Research Program"
  description="Core research investigations spanning computer vision diagnostics, deep learning object tracking, and applied predictive modeling."
>
  <div class="frame pt-28 pb-20">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-12">
      <!-- Sticky Table of Contents at xl+ per §7.2 -->
      <aside class="hidden xl:block xl:col-span-3">
        <div class="sticky top-28 space-y-4">
          <div class="font-mono text-xs uppercase text-[var(--text-muted)] tracking-wider">
            Contents
          </div>
          <TableOfContents headings={tocHeadings} />
        </div>
      </aside>

      <!-- Main Long-form Content (≤70ch) -->
      <div class="xl:col-span-9 space-y-16 max-w-[70ch]">
        <header class="space-y-4 border-b border-[var(--border-hairline)] pb-8">
          <h1
            class="text-[var(--step-4)] sm:text-[var(--step-5)] font-bold text-[var(--text-heading)] tracking-tight"
            style="font-family: var(--font-display); font-weight: 700;"
          >
            Research Program
          </h1>
          <p class="text-[var(--step-1)] text-[var(--text-body)] leading-relaxed">
            My research develops foundational and applied machine learning methodologies across computer vision, deep neural representations, and predictive analytics. Rooted in mathematical computing, this work targets high-accuracy visual diagnosis and reliable structured data modeling under unstructured field conditions.
          </p>
        </header>

        <!-- Direction Sections (§7.2) -->
        <div class="space-y-20">
          {
            sortedDirections.map((dir, index) => {
              // Related projects matching this research direction
              const relatedProjects = allProjects.filter((p) => {
                if (dir.data.slug === 'agricultural-vision') return p.data.slug === 'chilli-thrips-detection';
                if (dir.data.slug === 'object-tracking') return p.data.slug === 'real-time-object-tracking';
                if (dir.data.slug === 'predictive-modeling') return p.data.slug === 'road-accident-prediction' || p.data.slug === 'future-diabetes-prediction';
                return false;
              });

              return (
                <section id={dir.data.slug} class="space-y-6 scroll-mt-28">
                  <div class="space-y-2">
                    <span class="font-mono text-xs uppercase text-[var(--interactive)] tracking-wider">
                      Direction 0{index + 1}
                    </span>
                    <h2
                      class="text-[var(--step-3)] font-bold text-[var(--text-heading)] leading-snug"
                      style="font-family: var(--font-display); font-weight: 700;"
                    >
                      {dir.data.title}
                    </h2>
                  </div>

                  <!-- 3-5 paragraphs written for technically literate non-specialist -->
                  <div class="space-y-4 text-[var(--step-0)] text-[var(--text-body)] leading-relaxed">
                    <p>{dir.data.blurb}</p>
                    <p>{dir.data.body}</p>
                    <p>
                      In unstructured observational environments, noise and illumination variance degrade naive model predictions. By constructing tailored neural feature representations and disciplined validation splits, our methodology ensures models isolate genuine causal signals rather than spurious background correlations.
                    </p>
                  </div>

                  <!-- Figure with numbered caption in mono (§7.2) -->
                  <Figure
                    figureNumber={index + 1}
                    caption={`Algorithmic workflow and feature representation schematic for ${dir.data.title.toLowerCase()}.`}
                  >
                    <div class="h-36 flex items-center justify-center font-mono text-xs text-[var(--text-muted)] border border-[var(--border-hairline)] bg-[var(--bg-well)] rounded-none">
                      <div class="text-center space-y-1 px-4">
                        <div class="text-[var(--text-heading)] font-semibold">
                          FIG. 0{index + 1} // PIPELINE SCHEMATIC
                        </div>
                        <div class="text-[11px] text-[var(--text-muted)]">
                          Input Representation &rarr; Feature Map Extraction &rarr; Target Inference
                        </div>
                      </div>
                    </div>
                  </Figure>

                  <!-- Mono method tags per §7.2 -->
                  <div class="space-y-2 pt-2">
                    <div class="font-mono text-xs uppercase text-[var(--text-muted)]">
                      Methods & Technologies
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {dir.data.methods.map((method) => (
                        <span class="font-mono text-xs text-[var(--text-muted)] bg-[var(--bg-well)] px-2.5 py-1 rounded-[4px] border border-[var(--border-hairline)]">
                          {method}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Related output / projects (§7.2) -->
                  {relatedProjects.length > 0 && (
                    <div class="space-y-3 pt-6 border-t border-[var(--border-hairline)]">
                      <div class="font-mono text-xs uppercase text-[var(--interactive)]">
                        Related Implementations
                      </div>
                      <div class="space-y-3">
                        {relatedProjects.map((p) => (
                          <div class="p-4 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                              <div class="font-bold text-[var(--text-heading)] text-[var(--step-0)]">
                                {p.data.name}
                              </div>
                              <p class="text-xs text-[var(--text-muted)] mt-0.5">
                                {p.data.summary}
                              </p>
                            </div>
                            {p.data.repo && (
                              <a
                                href={p.data.repo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="link-volt text-xs font-mono shrink-0"
                              >
                                Source Code &rarr;
                              </a>
                            )}
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </section>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
