---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import DefinitionRow from '../components/common/DefinitionRow.astro';
import { formatDate } from '../lib/dates';
import { sortByDateDesc } from '../lib/sort';

const allTalks = await getCollection('talks');
const sortedTalks = sortByDateDesc(allTalks);

const allTeaching = await getCollection('teaching');
const sortedTeaching = [...allTeaching].sort((a, b) => b.data.year - a.data.year);

// Service activities (reviewing, organizing, mentoring) per §7.5 & §8
const serviceItems = [
  {
    period: '2025 – Present',
    title: 'Reviewer, IEEE Transactions on Pattern Analysis and Machine Intelligence (TPAMI)',
    role: 'Peer Review',
    desc: 'Reviewing manuscript submissions on self-supervised representation learning and vision transformers.',
  },
  {
    period: '2024 – 2025',
    title: 'Sub-reviewer, CVPR & ECCV Workshops',
    role: 'Conference Reviewing',
    desc: 'Assisted in evaluating workshop papers on geometric deep learning and agricultural anomaly detection.',
  },
  {
    period: '2023 – 2024',
    title: 'Mentor, Women in Data Science & Mathematics Circle, BHU',
    role: 'Academic Mentorship',
    desc: 'Mentored junior master students transitioning from pure mathematics into computational data science and ML.',
  },
  {
    period: '2023',
    title: 'Volunteer Organizer, Annual Science Day Computing Exhibition, BHU',
    role: 'Event Organization',
    desc: 'Organized computational demonstrations of neural network feature representations for visiting high school students.',
  },
];

const sections = [
  { id: 'talks', label: '01. TALKS' },
  { id: 'teaching', label: '02. TEACHING' },
  { id: 'service', label: '03. SERVICE' },
];
---

<BaseLayout
  title="Talks & Teaching"
  description="Invited lectures, conference presentations, university teaching assistantships, and academic service by Prerna Kumari."
  sections={sections}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-y-12 md:gap-x-6 py-12 md:py-16">
    <div class="md:col-start-2 md:col-span-8 space-y-16">

      <header class="space-y-4 border-b border-[var(--border-subtle)] pb-8">
        <h1 class="font-display text-[var(--step-5)] text-[var(--text-heading)] tracking-tight">
          Talks & Academic Service
        </h1>
        <p class="text-[var(--step-1)] text-[var(--text-muted)] leading-relaxed max-w-[68ch]">
          Invited colloquia, conference presentations, teaching instruction, and institutional peer review.
        </p>
      </header>

      <!-- 1. Talks Section per §7.5 -->
      <section id="talks" class="space-y-6 scroll-mt-24">
        <SectionHeading
          tag="PRESENTATIONS"
          title="Talks & Lectures"
          subtitle="Keynotes, spotlight sessions, and invited department seminars."
        />

        <div class="divide-y divide-[var(--border-subtle)]">
          {sortedTalks.map((talk) => {
            const d = talk.data;
            return (
              <DefinitionRow
                date={formatDate(d.date)}
                title={d.title}
                subtitle={`${d.event} · ${d.location}`}
                badge={d.type}
                link={d.slides || d.video}
              />
            );
          })}
        </div>
      </section>

      <!-- 2. Teaching Section per §7.5 -->
      <section id="teaching" class="space-y-6 scroll-mt-24">
        <SectionHeading
          tag="INSTRUCTION"
          title="Teaching"
          subtitle="Laboratory supervision and tutorial problem sessions."
        />

        <div class="divide-y divide-[var(--border-subtle)]">
          {sortedTeaching.map((course) => {
            const d = course.data;
            return (
              <DefinitionRow
                date={`${d.term} ${d.year}`}
                title={`${d.code}: ${d.title}`}
                subtitle={`${d.institution} — ${d.role}. ${d.description}`}
              />
            );
          })}
        </div>
      </section>

      <!-- 3. Service Section per §7.5 -->
      <section id="service" class="space-y-6 scroll-mt-24">
        <SectionHeading
          tag="COMMUNITY"
          title="Academic Service & Reviewing"
          subtitle="Journal refereeing, workshop organization, and student mentoring."
        />

        <div class="divide-y divide-[var(--border-subtle)]">
          {serviceItems.map((item) => (
            <DefinitionRow
              date={item.period}
              title={item.title}
              subtitle={`${item.role} — ${item.desc}`}
            />
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
