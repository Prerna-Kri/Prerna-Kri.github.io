---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { withBase } from '../lib/paths';

const education = await getCollection('education');
const experience = await getCollection('experience');
const projects = await getCollection('projects');
const awards = await getCollection('awards');
const skills = await getCollection('skills');
const teaching = await getCollection('teaching');
const publications = await getCollection('publications');

const sortedEducation = education.sort((a, b) => (b.data.start > a.data.start ? 1 : -1));
const sortedAwards = awards.sort((a, b) => b.data.year - a.data.year);
const sortedSkills = skills.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Curriculum Vitae"
  description={`Academic Curriculum Vitae for ${site.name} — ${site.role}, ${site.institution}.`}
>
  <div class="frame pt-28 pb-20 space-y-12">
    <!-- Header with Download PDF Button (§7.5) -->
    <header class="border-b border-[var(--border-hairline)] pb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <div class="space-y-2">
        <h1
          class="text-[var(--step-4)] sm:text-[var(--step-5)] font-bold text-[var(--text-heading)] tracking-tight"
          style="font-family: var(--font-display); font-weight: 700;"
        >
          Curriculum Vitae
        </h1>
        <p class="text-[var(--step-0)] text-[var(--text-muted)]">
          {site.name} · {site.role} · {site.lab}, {site.institution}
        </p>
      </div>

      <div class="no-print shrink-0">
        <a
          href={withBase(site.cvPdf)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[4px] bg-[var(--interactive)] text-[#120722] font-semibold text-[var(--step--1)] hover:opacity-90 transition-opacity"
        >
          <span>Download PDF</span>
        </a>
      </div>
    </header>

    <div class="space-y-16 max-w-[70ch]">
      <!-- 1. Education -->
      <section class="cv-entry space-y-6">
        <h2
          class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
          style="font-family: var(--font-display);"
        >
          Education
        </h2>
        <div class="space-y-6 divide-y divide-[var(--border-hairline)]">
          {
            sortedEducation.map((item) => (
              <div class="pt-4 first:pt-0 space-y-1">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                    {item.data.degree} in {item.data.field}
                  </h3>
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {item.data.start} – {item.data.end || 'Present'}
                  </span>
                </div>
                <div class="text-[var(--step--1)] text-[var(--text-body)]">
                  {item.data.institution}
                </div>
                {item.data.thesis && (
                  <p class="text-xs text-[var(--text-muted)] pt-1">
                    {item.data.thesis}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 2. Technical & Research Experience -->
      <section class="cv-entry space-y-6">
        <h2
          class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
          style="font-family: var(--font-display);"
        >
          Technical & Research Experience
        </h2>
        <div class="space-y-6 divide-y divide-[var(--border-hairline)]">
          {
            experience.map((item) => (
              <div class="pt-4 first:pt-0 space-y-2">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                    {item.data.role} · {item.data.org}
                  </h3>
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {item.data.start} – {item.data.end || 'Present'}
                  </span>
                </div>
                <div class="font-mono text-xs text-[var(--text-muted)]">
                  {item.data.location}
                </div>
                <ul class="list-disc list-outside pl-5 space-y-1 text-[var(--step--1)] text-[var(--text-body)]">
                  {item.data.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 3. Key Projects -->
      <section class="cv-entry space-y-6">
        <h2
          class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
          style="font-family: var(--font-display);"
        >
          Computational Projects
        </h2>
        <div class="space-y-6 divide-y divide-[var(--border-hairline)]">
          {
            projects.map((p) => (
              <div class="pt-4 first:pt-0 space-y-1">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                    {p.data.name}
                  </h3>
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {p.data.year}
                  </span>
                </div>
                <p class="text-[var(--step--1)] text-[var(--text-body)]">
                  {p.data.description}
                </p>
                <div class="font-mono text-xs text-[var(--text-muted)] pt-1">
                  Stack: {p.data.stack.join(', ')}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 4. Honors & Certifications -->
      <section class="cv-entry space-y-6">
        <h2
          class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
          style="font-family: var(--font-display);"
        >
          Certifications & National Qualifications
        </h2>
        <div class="space-y-4 divide-y divide-[var(--border-hairline)]">
          {
            sortedAwards.map((a) => (
              <div class="pt-3 first:pt-0 space-y-1">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <h3 class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                    {a.data.title}
                  </h3>
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {a.data.year}
                  </span>
                </div>
                <div class="text-xs text-[var(--text-muted)]">
                  {a.data.issuer}
                </div>
                {a.data.description && (
                  <p class="text-xs text-[var(--text-body)]">
                    {a.data.description}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 5. Technical Skills (Plain grouped text - §7.5) -->
      <section class="cv-entry space-y-6">
        <h2
          class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
          style="font-family: var(--font-display);"
        >
          Technical Competencies
        </h2>
        <div class="space-y-4">
          {
            sortedSkills.map((s) => (
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <div class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                  {s.data.group}
                </div>
                <div class="sm:col-span-2 text-[var(--step--1)] text-[var(--text-body)]">
                  {s.data.items.join(' · ')}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 6. Teaching & Mentoring -->
      {
        teaching.length > 0 && (
          <section class="cv-entry space-y-6">
            <h2
              class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
              style="font-family: var(--font-display);"
            >
              Academic Mentoring & Teaching
            </h2>
            <div class="space-y-4 divide-y divide-[var(--border-hairline)]">
              {teaching.map((t) => (
                <div class="pt-3 first:pt-0 space-y-1">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h3 class="font-semibold text-[var(--step-0)] text-[var(--text-heading)]">
                      {t.data.role} · {t.data.title}
                    </h3>
                    <span class="font-mono text-xs text-[var(--text-muted)]">
                      {t.data.year}
                    </span>
                  </div>
                  <div class="text-xs text-[var(--text-muted)]">
                    {t.data.institution} · {t.data.term}
                  </div>
                  <p class="text-xs text-[var(--text-body)]">
                    {t.data.description}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- 7. Publications (rendered only if present) -->
      {
        publications.length > 0 && (
          <section class="cv-entry space-y-6">
            <h2
              class="text-[var(--step-2)] font-bold text-[var(--text-heading)] border-b border-[var(--border-hairline)] pb-2"
              style="font-family: var(--font-display);"
            >
              Publications
            </h2>
            <div class="space-y-4">
              {publications.map((pub) => (
                <div class="text-[var(--step--1)] text-[var(--text-body)]">
                  <span class="font-semibold text-[var(--text-heading)]">{pub.data.title}</span>. {pub.data.authors.join(', ')}. <em>{pub.data.venue}</em>, {pub.data.year}.
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
