---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/dates';
import { withBase } from '../../lib/paths';
import { calculateReadingTime } from '../../lib/readingTime';

// Filter out drafts in production per §8
const posts = await getCollection('writing', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const allTags = Array.from(new Set(sortedPosts.flatMap((p) => p.data.tags)));
---

<BaseLayout
  title="Writing & Notes"
  description="Technical notes, mathematical derivations, and explainers by Prerna Kumari."
>
  <div class="frame pt-28 pb-20 space-y-12">
    <header class="space-y-4 border-b border-[var(--border-hairline)] pb-8 max-w-[70ch]">
      <h1
        class="text-[var(--step-4)] sm:text-[var(--step-5)] font-bold text-[var(--text-heading)] tracking-tight"
        style="font-family: var(--font-display); font-weight: 700;"
      >
        Writing & Notes
      </h1>
      <p class="text-[var(--step-1)] text-[var(--text-body)] leading-relaxed">
        Technical explainers, mathematical derivations, and research notes in computer vision and machine learning.
      </p>

      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="font-mono text-xs text-[var(--text-muted)] py-1">Tags:</span>
          {allTags.map((tag) => (
            <span class="font-mono text-xs px-2.5 py-0.5 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] text-[var(--text-muted)]">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Reverse-chronological rows per §7.6 -->
    <div class="divide-y divide-[var(--border-hairline)] border-y border-[var(--border-hairline)] max-w-[70ch]">
      {
        sortedPosts.map((post) => {
          const d = post.data;
          const readingTime = calculateReadingTime(post.body || '');
          const postSlug = post.id.replace(/\.[^/.]+$/, '');
          const postUrl = withBase(`/writing/${postSlug}`);

          return (
            <article class="py-6 items-baseline transition-colors hover:bg-[var(--bg-well)] px-2 -mx-2 rounded-[4px] space-y-2 group">
              <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--text-muted)]">
                <time datetime={new Date(d.date).toISOString()}>{formatDate(d.date)}</time>
                <span>·</span>
                <span>{readingTime}</span>
              </div>

              <h2
                class="text-[var(--step-1)] font-bold text-[var(--text-heading)] leading-snug group-hover:text-[var(--interactive)] transition-colors"
                style="font-family: var(--font-display); font-weight: 700;"
              >
                <a href={postUrl}>
                  {d.title}
                </a>
              </h2>

              <p class="text-[var(--step-0)] text-[var(--text-body)] leading-relaxed">
                {d.description}
              </p>

              <div class="pt-2">
                <a
                  href={postUrl}
                  class="link-volt font-mono text-xs font-medium inline-flex items-center gap-1"
                >
                  <span>Read note &rarr;</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
