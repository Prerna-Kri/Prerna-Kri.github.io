---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionRule from '../components/layout/SectionRule.astro';
import NameBand from '../components/hero/NameBand.astro';
import NowList from '../components/sections/NowList.astro';
import DirectionGrid from '../components/sections/DirectionGrid.astro';
import ProjectRow from '../components/sections/ProjectRow.astro';
import WritingList from '../components/sections/WritingList.astro';
import PublicationList from '../components/sections/PublicationList.astro';
import ContactBand from '../components/sections/ContactBand.astro';
import { site } from '../config/site';
import { hasEntries } from '../lib/collections';

const hasNotes = await hasEntries('writing');
const hasPubs = await hasEntries('publications');
---

<BaseLayout
  title={`${site.name} — ${site.role}, ${site.field}`}
  description={`${site.name} is a ${site.role} in ${site.field} at ${site.institution}. ${site.tagline}`}
  isHome={true}
>
  <!-- 1. Signature Name Band (§7.1) -->
  <NameBand />

  <!-- 2. Full-bleed structural rule for Now -->
  <SectionRule id="rule-for-now" />

  <!-- 3. Now Section (§7.1) -->
  <NowList />

  <!-- 4. Full-bleed structural rule for Focus -->
  <SectionRule id="rule-for-focus" />

  <!-- 5. Focus Section: 3 Research Directions (§7.1) -->
  <DirectionGrid />

  <!-- 6. Full-bleed structural rule for Work -->
  <SectionRule id="rule-for-work" />

  <!-- 7. Work Section: Featured Projects (§7.1) -->
  <ProjectRow />

  <!-- 8. Writing Section (if entries exist) -->
  {
    hasNotes && (
      <>
        <SectionRule id="rule-for-writing" />
        <WritingList />
      </>
    )
  }

  <!-- 9. Publications Section (gated strictly by collection entries) -->
  {
    hasPubs && (
      <>
        <SectionRule id="rule-for-publications" />
        <PublicationList />
      </>
    )
  }

  <!-- 10. Full-bleed Contact Band (§7.1) -->
  <ContactBand />
</BaseLayout>
