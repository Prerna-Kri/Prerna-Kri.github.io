---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
import { withBase } from '../lib/paths';

const mainSections = [
  { href: withBase('/research'), label: 'Research' },
  { href: withBase('/publications'), label: 'Publications' },
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/cv'), label: 'Curriculum Vitae' },
];
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be located."
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-y-8 md:gap-x-6 py-24 md:py-32">
    <div class="md:col-start-2 md:col-span-8 space-y-8 max-w-[55ch]">

      <header class="space-y-3">
        <div class="font-mono text-xs text-[var(--accent-signal)]">
          // ERROR 404
        </div>
        <h1 class="font-display text-[var(--step-4)] text-[var(--text-heading)] leading-tight">
          That page doesn't exist.
        </h1>
        <p class="text-[var(--step-0)] text-[var(--text-muted)]">
          The link you followed may be outdated or mistyped.
        </p>
      </header>

      <!-- Search trigger input per §7.8 -->
      <div class="pt-2">
        <button
          type="button"
          data-command-palette-trigger
          class="w-full flex items-center justify-between px-4 py-3 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-heading)] hover:border-[var(--border-strong)] transition-colors cursor-pointer font-mono text-xs"
        >
          <div class="flex items-center gap-2.5">
            <Icon name="search" size={16} />
            <span>Search publications, projects, or notes...</span>
          </div>
          <kbd class="px-1.5 py-0.5 rounded border border-[var(--border-subtle)] bg-[var(--bg-well)] text-[10px]">⌘K</kbd>
        </button>
      </div>

      <!-- Links to the four main sections per §7.8 -->
      <div class="pt-4 border-t border-[var(--border-subtle)] space-y-3">
        <div class="font-mono text-xs text-[var(--text-muted)] uppercase tracking-wider">
          Main Sections
        </div>
        <ul class="grid grid-cols-2 gap-3 font-mono text-xs">
          {
            mainSections.map((sec) => (
              <li>
                <a
                  href={sec.href}
                  class="block p-3 rounded-[4px] border border-[var(--border-subtle)] bg-[var(--bg-well)] text-[var(--text-body)] hover:text-[var(--accent-signal)] hover:border-[var(--accent-signal)] transition-colors"
                >
                  {sec.label} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>
  </div>
</BaseLayout>
