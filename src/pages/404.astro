---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
import { withBase } from '../lib/paths';

const mainSections = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/research'), label: 'Research' },
  { href: withBase('/work'), label: 'Work' },
  { href: withBase('/writing'), label: 'Writing' },
  { href: withBase('/cv'), label: 'Curriculum Vitae' },
];
---

<BaseLayout
  title="Page Not Found"
  description="That page doesn't exist."
>
  <div class="frame pt-32 pb-24 space-y-8 max-w-[50ch]">
    <header class="space-y-3">
      <h1
        class="text-[var(--step-3)] font-bold text-[var(--text-heading)] leading-tight"
        style="font-family: var(--font-display); font-weight: 700;"
      >
        That page doesn't exist.
      </h1>
      <p class="text-[var(--step-0)] text-[var(--text-muted)]">
        The link you followed may be outdated or mistyped.
      </p>
    </header>

    <!-- Command palette button (§7.7) -->
    <div>
      <button
        type="button"
        data-command-palette-trigger
        class="w-full flex items-center justify-between px-4 py-3 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] text-[var(--text-muted)] hover:text-[var(--text-heading)] hover:border-[var(--interactive)] transition-colors cursor-pointer text-xs"
      >
        <div class="flex items-center gap-2.5">
          <Icon name="search" size={15} />
          <span>Search projects, notes, or sections...</span>
        </div>
        <kbd class="font-mono px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[10px]">⌘K</kbd>
      </button>
    </div>

    <!-- Links to main sections (§7.7) -->
    <div class="pt-4 border-t border-[var(--border-hairline)] space-y-3">
      <div class="text-xs font-medium text-[var(--text-heading)]">
        Main Sections
      </div>
      <ul class="grid grid-cols-2 gap-2 text-xs">
        {
          mainSections.map((sec) => (
            <li>
              <a
                href={sec.href}
                class="block p-2.5 rounded-[4px] border border-[var(--border-hairline)] bg-[var(--bg-well)] text-[var(--text-body)] hover:text-[var(--interactive)] hover:border-[var(--interactive)] transition-colors"
              >
                {sec.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
