{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "astro"
  },
  "exclude": ["dist", "node_modules", "scratch"]
}
